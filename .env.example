# Environment Configuration Example
# Copy this file to .env and update values as needed

# Application Settings
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Application Settings
APP_TITLE=Inventory Management System
APP_VERSION=2.0.0
DEBUG=False

# Logging
LOG_LEVEL=INFO
